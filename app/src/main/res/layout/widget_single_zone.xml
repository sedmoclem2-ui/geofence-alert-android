<?xml version="1.0" encoding="utf-8"?>
<!-- ویجت اختصاصی یک محدوده -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tv_zone_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="محدوده"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#1E1B14" />

    <TextView
        android:id="@+id/tv_zone_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textSize="14sp"
        android:textColor="#5C5648" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_zone_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="توقف هشدار" />

        <Button
            android:id="@+id/btn_zone_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="فعال/غیرفعال" />

    </LinearLayout>

</LinearLayout>
