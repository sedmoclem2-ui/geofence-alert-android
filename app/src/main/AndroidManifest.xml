<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- موقعیت برای تشخیص ورود به محدوده -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- موقعیت پس‌زمینه برای ژئوفنسینگ وقتی برنامه باز نیست -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- نمایش اعلان هشدار (اندروید ۱۳ به بالا) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- سرویس پیش‌زمینه برای پخش ممتد هشدار -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- بازیابی محدوده‌ها پس از روشن شدن گوشی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- نگه داشتن پردازنده بیدار هنگام پخش هشدار با صفحه خاموش -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".GeofenceAlertApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.GeofenceAlert"
        android:allowBackup="true"
        android:supportsRtl="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GeofenceAlert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- دریافت رویدادهای ورود/خروج ژئوفنس -->
        <receiver
            android:name=".geofence.GeofenceReceiver"
            android:exported="false" />

        <!-- توقف هشدار از طریق دکمه اعلان -->
        <receiver
            android:name=".receiver.StopAlertReceiver"
            android:exported="false" />

        <!-- ثبت مجدد محدوده‌ها پس از راه‌اندازی مجدد گوشی -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- سرویس پیش‌زمینه پخش هشدار صوتی -->
        <service
            android:name=".service.AlertService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
