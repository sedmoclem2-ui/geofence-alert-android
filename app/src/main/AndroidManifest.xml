<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- موقعیت برای تشخیص ورود به محدوده -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- موقعیت پس‌زمینه برای ژئوفنسینگ وقتی برنامه باز نیست -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- نمایش اعلان هشدار (اندروید ۱۳ به بالا) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- سرویس پیش‌زمینه برای پخش ممتد هشدار -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- بازیابی محدوده‌ها پس از روشن شدن گوشی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- نگه داشتن پردازنده بیدار هنگام پخش هشدار با صفحه خاموش -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- ارسال پیامک اطلاع‌رسانی ورود به محدوده (فقط شماره‌های تعریف‌شده کاربر) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- فقط در اندروید ۹ و پایین‌تر: نوشتن پشتیبان خودکار در Documents عمومی -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- فقط برای کاشی‌های نقشه در صفحه «انتخاب روی نقشه» -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".GeofenceAlertApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GeofenceAlert"
        android:allowBackup="true"
        android:supportsRtl="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GeofenceAlert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- دریافت رویدادهای ورود/خروج ژئوفنس -->
        <receiver
            android:name=".geofence.GeofenceReceiver"
            android:exported="false" />

        <!-- توقف هشدار از طریق دکمه اعلان -->
        <receiver
            android:name=".receiver.StopAlertReceiver"
            android:exported="false" />

        <!-- تغییر وضعیت پایش از ویجت -->
        <receiver
            android:name=".receiver.WidgetActionReceiver"
            android:exported="false" />

        <!-- خودترمیمی دوره‌ای پس‌زمینه (فقط از AlarmManager داخلی) -->
        <receiver
            android:name=".receiver.SelfHealReceiver"
            android:exported="false" />

        <!-- یادآور ماندن طولانی داخل محدوده (فقط از AlarmManager داخلی) -->
        <receiver
            android:name=".receiver.StayReminderReceiver"
            android:exported="false" />

        <!-- کنش «غیر فعال کردن پایش» از اعلان «جی‌پی‌اس خاموش است» -->
        <receiver
            android:name=".receiver.GpsActionReceiver"
            android:exported="false" />

        <!-- ثبت مجدد محدوده‌ها پس از راه‌اندازی مجدد گوشی -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- سرویس پیش‌زمینه پخش هشدار صوتی -->
        <service
            android:name=".service.AlertService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- سرویس پیش‌زمینه پایش دقیق محدوده‌های کوچک (هر ۲۰ ثانیه) -->
        <service
            android:name=".service.ProximityMonitorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ویجت صفحه اصلی -->
        <receiver
            android:name=".widget.ZoneWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- ویجت تک‌محدوده: هر نمونه به یک محدوده متصل می‌شود -->
        <receiver
            android:name=".widget.SingleZoneWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_zone_widget_info" />
        </receiver>

        <!-- صفحه انتخاب محدوده برای ویجت تک‌محدوده -->
        <activity
            android:name=".widget.ZoneWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.GeofenceAlert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- کاشی تنظیمات سریع: فعال/غیرفعال کردن پایش از سایه اعلان -->
        <service
            android:name=".tile.MonitorTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_radar"
            android:label="محدوده هشدار"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
